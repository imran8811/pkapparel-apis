# Copy to .env and fill in. Never commit .env.
# The values are for the live server; the comments give the local (XAMPP) ones.
APP_ENV=production
# Locally: true (error details in API responses). Must be false on the live server.
APP_DEBUG=false
# Locally: http://127.0.0.1:8080
APP_URL=https://api.pkapparel.com
# Only when the API lives in a sub-folder, e.g. /api
APP_BASE_PATH=

# Shared secret between the website (API_CLIENT_KEY on Vercel / in web/.env.local) and this API
CLIENT_KEY=change-me-64-hex-chars

# The Next.js website, used for links in emails and to refresh its cache after admin changes
# (locally: http://localhost:3000)
WEB_URL=https://www.pkapparel.com
REVALIDATE_SECRET=change-me-64-hex-chars
# Set to 0 to skip the website cache refresh calls (e.g. when the website is not running)
WEB_REVALIDATE=1

# Locally: 127.0.0.1 with the XAMPP database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pkapparel
DB_USER=pkapparel
DB_PASSWORD=

# Email. MAIL_DRIVER=log writes emails to storage/logs/mail-*.log (development).
# Until MAIL_HOST, MAIL_USERNAME and MAIL_PASSWORD are all filled in, smtp also falls back to the log.
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@pkapparel.com
MAIL_FROM_NAME="PK Apparel"
# Staff notifications (new inquiries, orders)
MAIL_ADMIN_TO=info@pkapparel.com

# Old website (read-only source for the one-time import). Not needed on the live server.
LEGACY_DB_NAME=pkappar2_wholesale_2166718
LEGACY_UPLOADS_DIR=D:/xampp/htdocs/pkapparel/uploads
LEGACY_SITE_DIR=D:/xampp/htdocs/pkapparel
