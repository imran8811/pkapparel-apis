# Copy to .env and fill in. Never commit .env.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
# Only when the API lives in a sub-folder, e.g. /api
APP_BASE_PATH=

# Shared secret between the website (web/.env.local: API_CLIENT_KEY) and this API
CLIENT_KEY=change-me-64-hex-chars

# The Next.js website, used to refresh its cache after admin changes
WEB_URL=http://localhost:3000
REVALIDATE_SECRET=change-me-64-hex-chars

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pkapparel
DB_USER=pkapparel
DB_PASSWORD=

# Email. MAIL_DRIVER=log writes emails to storage/logs/mail-*.log (development).
# For real sending use MAIL_DRIVER=smtp, e.g. the info@pkapparel.com mailbox on your hosting.
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@pkapparel.com
MAIL_FROM_NAME="PK Apparel"
# Staff notifications (new inquiries, orders)
MAIL_ADMIN_TO=info@pkapparel.com

# Old website (read-only source for the one-time import)
LEGACY_DB_NAME=pkappar2_wholesale_2166718
LEGACY_UPLOADS_DIR=D:/xampp/htdocs/pkapparel/uploads
